{
  "name": "sentiboard-react-mockups",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SentiBoard v2 — SpaceX-inspired React UI mockups (dark + light). Design proposal only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript api/openapi.json -o src/api/schema.d.ts",
    "gen:api:refresh": "curl -fsS http://localhost:8000/openapi.json -o api/openapi.json.tmp && mv api/openapi.json.tmp api/openapi.json && npm run gen:api"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^1.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.10.1",
    "three": "^0.155.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.155.0",
    "@vitejs/plugin-react": "^4.3.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
