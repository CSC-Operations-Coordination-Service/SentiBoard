# Copy to .env.local (git-ignored) to override. Vite only exposes VITE_* variables to the app.

# Base URL for backend calls. The default "/api" goes through the dev-server proxy in
# vite.config.ts, which forwards to http://localhost:8000 and strips the /api prefix.
# Point it at an absolute URL to call a backend directly (that backend must allow CORS).
VITE_API_BASE_URL=/api

# Controls pages wired through src/api (currently: Processors).
# Default (VITE_USE_MOCKS unset, or any value other than "false"): mock data, no backend needed.
# Copy this file to .env.local and leave the value as "false" to switch to the real API.
# Pages not yet wired through src/api always use mock data, whatever this says.
VITE_USE_MOCKS=false
