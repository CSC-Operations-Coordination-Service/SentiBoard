{
    "aliases" : {
        "anomaly": {}
    },
    "index_patterns": [
        "anomaly-*"
    ],
    "settings": {
        "index": {
            "number_of_shards": 3,
            "number_of_replicas": 1
        }
    },
    "mappings": {
        "properties": {
            "id": {
                "type": "keyword",
                "meta": { "optional": true }
            },
            "key": {
                "type": "keyword"
            },
            "title": {
                "type": "text"
            },
            "text": {
                "type": "text"
            },
            "category": {
                "type": "keyword"
            },
            "impacted_satellite": {
                "type": "keyword",
                "meta": { "optional": true }
            },
            "impacted_item": {
                "type": "keyword",
                "meta": { "optional": true }
            },
            "start": {
                "type": "date"
            },
            "end": {
                "type": "date"
            },
            "environment": {
                "type": "keyword"
            },
            "datatakes_completeness": {
                "type": "nested",
                "properties": {
                    "datatakeID": { "type": "keyword" },
                    "L0_": { "type": "float", "meta": { "optional": true } },
                    "L1_": { "type": "float", "meta": { "optional": true } },
                    "L2_": { "type": "float", "meta": { "optional": true } }
                },
                "meta": { "array": true }
            },
            "news_link": {
                "type": "keyword",
                "meta": { "optional": true }
            },
            "news_title": {
                "type": "text", "fields": { "keyword": { "type": "keyword"}},
                "meta": { "optional": true }
            },
            "publication_date": {
                "type": "date"
            },
            "modify_date": {
                "type": "date"
            }
        }
    }
}