# Copy to .env.local (git-ignored). All variables are SERVER-ONLY: none is prefixed NEXT_PUBLIC_,
# so none reaches the browser bundle. Never put a secret in a NEXT_PUBLIC_* variable.

# Base URL of the FastAPI backend (no trailing slash). Read on the server only.
BACKEND_URL=http://localhost:8000

# Public origin of this site, for canonical URLs, Open Graph URLs, the sitemap and robots.txt.
SITE_URL=https://operations.dashboard.copernicus.eu

# "true" only in production: robots.txt then allows crawling and links the sitemap.
# Anything else (the default) disallows everything, as the legacy staging robots.txt did.
ALLOW_INDEXING=false

# Not here: the sub-path the site is served under (e.g. /sentiboard/frontend) is BASE_PATH, a BUILD
# argument. Next bakes it into links and assets, so setting it at `docker run` has no effect:
#   docker build --build-arg BASE_PATH=/sentiboard/frontend -t sentiboard-frontend .
