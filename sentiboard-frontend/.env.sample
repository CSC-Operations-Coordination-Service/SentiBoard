# Copy to .env.local (git-ignored). All variables are SERVER-ONLY: none is prefixed NEXT_PUBLIC_,
# so none reaches the browser bundle. Never put a secret in a NEXT_PUBLIC_* variable.

# Base URL of the FastAPI backend (no trailing slash). Read on the server only.
BACKEND_URL=http://localhost:8000

# Public origin of this site, for canonical URLs, Open Graph URLs, the sitemap and robots.txt.
SITE_URL=https://operations.dashboard.copernicus.eu

# "true" only in production: robots.txt then allows crawling and links the sitemap.
# Anything else (the default) disallows everything, as the legacy staging robots.txt did.
ALLOW_INDEXING=false

# Not here: the sub-path the site is served under (e.g. /sentiboard/frontend) is BASE_PATH, a BUILD
# argument. Next bakes it into links and assets, so setting it at `docker run` has no effect:
#   docker build --build-arg BASE_PATH=/sentiboard/frontend -t sentiboard-frontend .

# --- Logging (src/lib/log.ts) ---
# debug | info | warn | error. Default info.
# LOG_LEVEL=info
# json | text. Default: json when NODE_ENV=production (one line per record, for Loki), text otherwise.
# In json, every server-side console.* call (libraries, Next's own messages) is also turned into a
# JSON line (installConsoleBridge in src/lib/log.ts).
# LOG_FORMAT=text

# --- OpenTelemetry (src/instrumentation.node.ts) ---
# Off unless an OTLP endpoint is set. Traces (Next's request/render/fetch spans) and Node runtime
# metrics (heap per space, GC, event-loop delay) go to this OTLP/HTTP receiver, e.g. Alloy or a
# collector. Standard OTEL_* variables apply (protocol, sampler, export interval, OTEL_SDK_DISABLED).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=sentiboard-frontend
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
