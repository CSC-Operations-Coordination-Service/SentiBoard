{

 "$schema": "https://json-schema.org/draft/2020-12/schema",

 "description": "Copy of partner schema; only change: ref/#/defs/ corrected to $ref/#/$defs/ (typo in partner version).",

 "title": "EventCalendarDataResponse",

 "type": "object",

 "required": ["data_id", "title", "description", "events"],

 "properties": {

  "data_id": { "type": "string" },

  "title": { "type": "string" },

  "description": { "type": "string" },

  "events": { "type": "array", "items": { "$ref": "#/$defs/Event" } }

 },

 "$defs": {

  "Event": {

   "type": "object",

   "required": ["key", "occurred_at", "title", "description", "category",

          "category_basis", "origin", "status", "criticality",

          "affected_systems", "datatake_ids", "associated_datatake_count"],

   "properties": {

    "key": { "type": "string", "description": "Ticket ID, e.g. GSANOM-23018" },

    "occurred_at": {

     "type": ["string", "null"], "format": "date-time",

     "description": "Ticket occurrence time, ISO 8601 UTC with milliseconds, e.g. 2026-07-07T03:18:00.000Z"

    },

    "title": { "type": "string", "description": "\"Untitled anomaly ticket\" when the source has none" },

    "description": { "type": "string", "description": "Full ticket text; may be long; empty string when absent" },

    "category": { "enum": ["acquisition", "production", "rfi", "satellite", "other"] },

    "category_basis": { "enum": ["native_origin", "unclassified"] },

    "origin": {

     "type": ["string", "null"],

     "description": "Ticket origin as stored. Observed: RFI, Acquisition, Production, Satellite, IPF, MP, Other"

    },

    "status": {

     "enum": ["Open", "Closed", "Delegated", "Duplicated", "Rejected", "Completed",

          "Returned", "Transferred", "To be deployed", null]

    },

    "criticality": {

     "enum": ["Blocking", "Critical", "Routine", null],

     "description": "Severity, highest first: Blocking > Critical > Routine"

    },

    "affected_systems": { "type": "array", "items": { "type": "string" }, "description": "e.g. [\"S-1\"], [\"S-5p\"]; may be empty" },

    "datatake_ids": { "type": "array", "items": { "type": "string" }, "description": "e.g. [\"S1D-25912\"]; may be empty" },

    "associated_datatake_count": { "type": "integer", "minimum": 0, "description": "Length of datatake_ids" }

   }

  }

 }

}
